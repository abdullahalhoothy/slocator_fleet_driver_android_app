<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY — overrides app/src/main/res/xml/network_security_config.xml.

  The debug build talks to a plain-HTTP dev server whose host is usually a LAN IP
  (e.g. http://192.168.1.4:7080) that changes from one machine/network to the next.
  Rather than editing the strict release config every time, debug builds permit
  cleartext to any host. Release builds keep the restricted config from src/main.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
